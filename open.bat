@echo off
chcp 65001 >nul
rem ===========================================================================
rem  Тренажёры IT-квантума — открыть без сервера.
rem  Просто открывает каталог index.html в браузере по умолчанию.
rem  Ничего не устанавливается, сервер и интернет не нужны.
rem ===========================================================================
cd /d "%~dp0"
if not exist "index.html" (
  echo Файл index.html не найден в этой папке.
  echo Похоже, сайт ещё не собран: python3 build_site.py
  pause
  exit /b 1
)
echo Открываю каталог тренажёров: index.html
start "" "index.html"
