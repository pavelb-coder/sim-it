@echo off
chcp 65001 >nul
rem ===========================================================================
rem  Тренажёры IT-квантума — открыть без сервера.
rem  Работает и с локального диска, и с сетевой шары: путь берётся из %~dp0.
rem ===========================================================================
if not exist "%~dp0index.html" (
  echo Файл index.html не найден рядом со скриптом:
  echo   %~dp0
  echo Похоже, архив ещё не распакован. Щёлкните по ZIP правой кнопкой -
  echo "Извлечь все", затем запустите open.bat из распакованной папки.
  pause
  exit /b 1
)
echo Открываю каталог тренажёров: index.html
start "" "%~dp0index.html"
