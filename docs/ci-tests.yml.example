# Пример CI для GitHub Actions.
# Скопируйте файл в .github/workflows/tests.yml.
# Внимание: чтобы залить workflow через git, токен должен иметь scope `workflow`.

name: tests

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Проверки движка, задач и сборки
        working-directory: python-class
        run: |
          python3 build.py
          bash test.sh

      - name: Сборка должна быть актуальной
        working-directory: python-class
        run: git diff --exit-code -- dist/python-class.html
